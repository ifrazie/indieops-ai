{
  "name": "indieops-ai",
  "version": "1.0.0",
  "private": true,
  "description": "LiquidMetal AI app",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "start": "raindrop build deploy --start",
    "stop": "raindrop build stop",
    "restart": "raindrop build deploy --start",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smartbucket": "vitest run src/_test/smartbucket-validation.test.ts",
    "validate": "raindrop build validate",
    "generate": "raindrop build generate",
    "validate:smartbucket": "tsx scripts/validate-smartbucket.ts",
    "precheck": "npm run build && npm run validate && npm test",
    "predeploy": "npm run generate && npm run validate:smartbucket && npm run precheck"
  },
  "dependencies": {
    "@liquidmetal-ai/raindrop-framework": "0.11.0",
    "@modelcontextprotocol/sdk": "^1",
    "hono": "^4",
    "kysely": "^0.27.2",
    "kysely-d1": "^0.3.0",
    "zod": "^3"
  },
  "devDependencies": {
    "shx": "^0.4.0",
    "ts-node": "^10",
    "tsx": "^4.20.6",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.7.0",
    "vitest": "^3.1.3"
  }
}
