{
  "enabled": true,
  "name": "Code Quality Analyzer",
  "description": "Provides intelligent suggestions for code improvements including code smells, design patterns, best practices, readability, maintainability, and performance optimizations",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Analyze the modified code in the changed file for potential improvements. Focus on:\n\n1. **Code Smells**: Identify any code smells such as duplicated code, long methods, large classes, excessive parameters, or inappropriate intimacy between classes.\n\n2. **Design Patterns**: Suggest applicable design patterns that could improve the code structure and maintainability.\n\n3. **Best Practices**: Check adherence to TypeScript/JavaScript best practices, including proper error handling, type safety, async/await usage, and naming conventions.\n\n4. **Readability**: Evaluate code clarity, suggest better variable/function names, recommend breaking down complex logic, and improving code documentation.\n\n5. **Maintainability**: Identify areas that could be refactored for easier maintenance, suggest modularization opportunities, and highlight tight coupling.\n\n6. **Performance**: Spot potential performance issues such as unnecessary loops, inefficient algorithms, memory leaks, or blocking operations.\n\nProvide specific, actionable suggestions while maintaining the existing functionality. Prioritize the most impactful improvements and explain the reasoning behind each suggestion."
  },
  "workspaceFolderName": "indieops-ai",
  "shortName": "code-quality-analyzer"
}