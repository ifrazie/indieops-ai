application "indieops-ai" {

  # Asynchronous queue for sending notifications
  queue "notifications" {}

  observer "notification-handler" {
    # Observer for queue messages
    source {
      queue = "notifications"
    }
  }

  # Storage for contracts, receipts, and invoices
  smartbucket "documents" {}

  # Stores client details and relationship context
  smartmemory "agent_memory" {}

  # Stores financial records extracted from docs
  smartsql "ssql" {}

  kv_cache "kv-cache" {}

  # Public endpoint to receive data or file upload URLs
  service "api-gateway" {
    visibility = "public"
  }

  # The core brain for extraction and advisory
  service "llm-chat" {
    visibility = "public"
  }

  # MCP
  mcp_service "mcp" {
    visibility = "public"
  }

  # The "Daily Brief" - runs daily at 8:00 AM
  task "daily-brief" {
    type = "cron"
    cron = "0 8 * * *"
  }

}